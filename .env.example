AWS_REGION=us-east-1
# FREE / LOCAL TESTING: use a free Neon or Supabase PostgreSQL database.
DATABASE_URL=postgresql://user:password@host:5432/database
# Cloudflare R2 is S3-compatible. Leave CALL_DATA_KMS_KEY_ID unset for R2.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
CALL_DATA_BUCKET=client-call-intelligence-prod
CALL_DATA_KMS_KEY_ID=
QUEUE_MODE=inline
# Leave KNOWLEDGE_BASE_ID unset; local Chroma handles retrieval.
PROCESSING_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/call-processing-prod
PUBLIC_BASE_URL=https://calls.example.com
GROQ_API_KEY=replace-me
GROQ_AGENT_MODEL=llama-3.1-8b-instant
GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
VAPI_API_KEY=replace-me
VAPI_ASSISTANT_ID=replace-with-vapi-assistant-id
VAPI_PHONE_NUMBER_ID=replace-with-vapi-phone-number-id
VAPI_WEBHOOK_SECRET=replace-with-32-or-more-random-bytes
GHL_OUTBOUND_WEBHOOK_SECRET=replace-with-32-or-more-random-bytes
OUTBOUND_TRIGGER_SECRET=replace-with-32-or-more-random-bytes
CALCOM_API_KEY=replace-me
CALCOM_API_BASE_URL=https://api.cal.com/v2
REPORT_SENDER=reports@example.com
REPORT_RECIPIENTS=supervisor@example.com,management@example.com
AGENT_GREETING=Thank you for calling. How may I help you today?
DASHBOARD_JWT_SECRET=replace-with-32-or-more-random-bytes
# Production SSO: set these to use Auth0, Okta, Microsoft Entra ID, or another OIDC provider.
OIDC_ISSUER=https://your-identity-provider.example.com/
OIDC_AUDIENCE=callsignal-api
OIDC_CLAIMS_NAMESPACE=https://callsignal.example.com/
CHROMA_PERSIST_DIR=./data/chroma
RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=2555
CRM_WEBHOOK_URL=https://crm.example.com/webhooks/callsignal
CRM_WEBHOOK_TOKEN=replace-me
STORE_RAW_TRANSCRIPTS=false
MAX_REQUEST_BYTES=1048576
# Use a reviewed, versioned policy file. Mount it read-only in ECS or package it in the image.
TENANT_POLICY_FILE=/service/policies/tenants.json
# Legacy fallback only. Prefer TENANT_POLICY_FILE.
TENANT_ROUTING_JSON={}
