project = "leadlens"
environment = "production"
aws_region = "us-east-1"
image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/leadlens:stable"
certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/replace-me"
vpc_id = "vpc-replace-me"
public_subnet_ids = ["subnet-replace-me", "subnet-replace-me"]
private_subnet_ids = ["subnet-replace-me", "subnet-replace-me"]
public_base_url = "https://calls.example.com"
twilio_account_sid = "ACreplace-me"
report_sender = "reports@example.com"
report_recipients = "supervisor@example.com,management@example.com"
alert_email = "oncall@example.com"
dashboard_jwt_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:leadlens/dashboard-jwt"
openai_api_key_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:leadlens/openai"
twilio_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:leadlens/twilio"
call_center_webhook_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:leadlens/call-center-webhook"
tenant_policy_json = <<-JSON
{
	"version": 1,
	"tenants": {
		"+15551234567": {
			"tenant_id": "client-acme",
			"escalation_number": "+15557654321",
			"jurisdiction": "US-CA",
			"processing_region": "us-east-1",
			"speech_language": "en-US",
			"privacy_notice_version": "US-CA-2026-01",
			"lawful_basis": "consent",
			"recording_consent_required": "true",
			"dpia_approved": "true",
			"cross_border_safeguard": "contractual_safeguards",
			"approved_by": "Client privacy officer",
			"approved_at": "2026-09-07",
			"data_protection_contact": "privacy@example.com"
		}
	}
}
JSON